# Shared environment for all MMH volatile-traits lab runs.
# Source this before running anything that touches meta_memory, so trait embeddings are
# semantic AND identical across every arm. Mixing providers between capture and analysis
# would make trait vectors incomparable -- the embeddings are frozen at capture time.

export HF_HOME=/dataset1/yangfan/.cache/huggingface
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

# Semantic embedding provider. MMH's default is normalized feature hashing, which scores
# cos(paraphrase)=0.0 -- it measures token overlap, not meaning. Verified contrast on the
# same pair: Qwen3-Embedding 0.778 vs hash 0.000.
export MMH_EMBEDDING_PROVIDER=sentence-transformers
export MMH_EMBEDDING_LOCAL_MODEL=/dataset1/yangfan/.cache/huggingface/hub/models--Qwen--Qwen3-Embedding-0.6B/snapshots/97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
export MMH_EMBEDDING_LOCAL_TRUST_REMOTE_CODE=0

# Local vLLM endpoints (through their capture proxies).
export OPENAI_API_KEY=EMPTY
export TTHE_CONFIG=/home/yangfan/TTHE/config.yaml
export PYTHONPATH=/home/yangfan/TTHE
export PYTHONUNBUFFERED=1

# 27B (GPU 0) via its capture proxy -- solver/judge.
export PROXY_27B=http://127.0.0.1:8100/v1
# 8B (GPU 1) via its capture proxy.
export PROXY_8B=http://127.0.0.1:8101/v1
